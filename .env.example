# Copy this file to `.env` and fill it in. `.env` is loaded automatically
# by ecosystem.config.js (no need to prefix variables on the pm2 command
# line); a variable set in the shell wins over the value in `.env`.
# Never commit `.env` — it holds the webhook secret (see .gitignore).
APP_NAME=webhook
COMMAND=echo hello
SECRET=change-me
PORT=3002
